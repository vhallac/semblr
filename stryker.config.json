{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"testRunner": "vitest",
	"testFiles": ["src/**/*.test.ts", "scripts/**/*.test.ts"],
	"vitest": {
		"configFile": "vitest.config.ts",
		"related": false
	},
	"reporters": ["clear-text", "progress"],
	"coverageAnalysis": "perTest",
	"mutate": [
		"src/core/**/*.ts"
	],
	"ignorePatterns": [
		".jj",
		"coverage",
		"temp",
		"stryker.config.json",
		"justfile",
		"knip.json",
		"shell.nix"
	],
	"tsconfigFile": "tsconfig.json",
	"thresholds": {
		"high": 80,
		"low": 60,
		"break": 50
	}
}
